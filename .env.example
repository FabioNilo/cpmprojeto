# Opcao A - Postgres local via Docker (docker compose -f docker-compose.dev.yml up -d db)
DATABASE_URL="postgresql://cpm:cpm_dev_password@127.0.0.1:5434/cpm_disciplinar?schema=public"

# Opcao B - Supabase (session pooler, porta 5432 -- NAO 6543, o transaction
# pooler quebra $transaction interativa). Use um schema dedicado quando o
# projeto Supabase for compartilhado com outro app:
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:5432/postgres?schema=cpm"
# (crie o schema uma vez: CREATE SCHEMA IF NOT EXISTS cpm;)

SESSION_COOKIE_NAME="cpm_session"
SESSION_SECRET="troque-este-valor-em-producao"
NEXT_PUBLIC_APP_NAME="Sistema Disciplinar CPM"

# D10 - Object storage para anexos (Supabase Storage do MESMO projeto do banco).
# O bucket privado ja foi criado direto via SQL (storage.buckets). So falta
# colar a service_role key (Project Settings -> API). NUNCA versione o .env real.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"
SUPABASE_STORAGE_BUCKET="anexos-disciplina"

# ---------------------------------------------------------------------------
# Deploy em producao (EasyPanel, docker-compose.yml)
# ---------------------------------------------------------------------------
# NAO preencha valores reais neste arquivo para producao. No EasyPanel, va no
# app -> aba "Environment" e cadastre cada variavel acima (DATABASE_URL,
# SESSION_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_STORAGE_BUCKET, SESSION_COOKIE_NAME, NEXT_PUBLIC_APP_NAME) como
# "Environment Variable" do servico -- elas ficam criptografadas no painel,
# nunca entram na imagem Docker nem no repositorio. O docker-compose.yml so
# referencia "${VAR}"; quem preenche o valor e o EasyPanel.
#
# SESSION_SECRET de producao deve ser um valor aleatorio forte, diferente do
# de desenvolvimento (gerar com: openssl rand -base64 32).
